{
  "name": "epaper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "ingest": "tsx --tsconfig tsconfig.json scripts/ingest.ts",
    "typecheck": "tsc --noEmit",
